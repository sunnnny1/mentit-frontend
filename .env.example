# Gumloop 유니 에이전트 연결용 (서버 전용 값입니다. VITE_ 접두사를 붙이지 마세요)
# 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
GUMLOOP_API_KEY=
GUMLOOP_USER_ID=
GUMLOOP_GUMMIE_ID=
# 멘토 채팅(최윤희 멘토 에이전트)용 에이전트 ID. 주소가 .../jJLB.../chat/xxxx 형태라면 앞쪽 ID만 넣으세요.
GUMLOOP_GUMMIE_ID_YOONIE_MENTOR=
GUMLOOP_GUMMIE_ID_MENTIT=
# AI Agent 대화 요약 에이전트 ID
GUMLOOP_GUMMIE_ID_SUMMARY=
# Eunoia AI Agent 채팅 에이전트 ID
GUMLOOP_GUMMIE_ID_EUNOIA=
# Eunoia(이지희) 멘토 채팅 에이전트 ID
GUMLOOP_GUMMIE_ID_EUNOIA_MENTOR=
